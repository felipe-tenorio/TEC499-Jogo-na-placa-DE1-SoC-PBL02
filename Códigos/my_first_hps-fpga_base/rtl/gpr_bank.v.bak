// gpr_bank.v — 16 GPRs de 16 bits; R0 sempre 0 (somente leitura)
module gpr_bank (
    input  wire        clk,
    input  wire        reset,
    input  wire        we,
    input  wire [3:0]  wa,
    input  wire [15:0] wd,
    input  wire [3:0]  ra1,
    input  wire [3:0]  ra2,
    output wire [15:0] rd1,
    output wire [15:0] rd2
);
    reg [15:0] regs [0:15];
    integer i;
    assign rd1 = (ra1 == 4'd0) ? 16'd0 : regs[ra1];
    assign rd2 = (ra2 == 4'd0) ? 16'd0 : regs[ra2];
    always @(posedge clk) begin
        if (reset) begin
            for (i = 0; i < 16; i = i + 1) regs[i] <= 16'd0;
        end else if (we && (wa != 4'd0)) begin
            regs[wa] <= wd;
        end
    end
endmodule
